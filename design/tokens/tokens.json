{
  "$comment": "BodegApp design tokens (F0-01) — formato listo para Tailwind CSS config. Fuente: docs/REQUERIMIENTOS.md §4. Hex oficiales del inversor; derivados documentados en design/design-system.md.",
  "colors": {
    "light": {
      "primary": "#C41230",
      "primary-deep": "#800020",
      "secondary": "#FFB81C",
      "accent": "#2E7D32",
      "background": "#F8F9FA",
      "surface": "#FFFFFF",
      "surface-hover": "color-mix(in srgb, #000000 4%, #FFFFFF)",
      "text-primary": "#212529",
      "text-secondary": "#6C757D",
      "border": "color-mix(in srgb, #6C757D 25%, transparent)",
      "on-primary": "#FFFFFF",
      "on-primary-deep": "#FFFFFF",
      "on-secondary": "#212529",
      "on-accent": "#FFFFFF",
      "destructive": "#800020",
      "on-destructive": "#FFFFFF"
    },
    "dark": {
      "primary": "#E53935",
      "primary-deep": "#C41230",
      "secondary": "#FFCA28",
      "accent": "#81C784",
      "background": "#121212",
      "surface": "#1E1E1E",
      "surface-hover": "color-mix(in srgb, #FFFFFF 6%, #1E1E1E)",
      "surface-raised": "color-mix(in srgb, #FFFFFF 6%, #1E1E1E)",
      "text-primary": "#FFFFFF",
      "text-primary-soft": "#E0E0E0",
      "text-secondary": "#9E9E9E",
      "border": "#2C2C2C",
      "on-primary": "#FFFFFF",
      "on-secondary": "#121212",
      "on-accent": "#121212",
      "destructive": "#E53935",
      "on-destructive": "#FFFFFF"
    }
  },
  "fontFamily": {
    "heading": ["Plus Jakarta Sans", "Cabinet Grotesk", "system-ui", "sans-serif"],
    "body": ["Inter", "SF Pro Display", "system-ui", "sans-serif"]
  },
  "fontSize": {
    "h1": ["32px", { "lineHeight": "1.2", "letterSpacing": "-0.02em", "fontWeight": "800" }],
    "h2": ["24px", { "lineHeight": "1.25", "letterSpacing": "-0.01em", "fontWeight": "700" }],
    "h3": ["20px", { "lineHeight": "1.3", "letterSpacing": "-0.01em", "fontWeight": "700" }],
    "h4": ["18px", { "lineHeight": "1.35", "fontWeight": "600" }],
    "body-lg": ["16px", { "lineHeight": "1.5", "fontWeight": "400" }],
    "body": ["14px", { "lineHeight": "1.5", "fontWeight": "400" }],
    "body-sm": ["13px", { "lineHeight": "1.45", "fontWeight": "400" }],
    "caption": ["12px", { "lineHeight": "1.4", "letterSpacing": "0.01em", "fontWeight": "400" }],
    "price": ["20px", { "lineHeight": "1.2", "fontWeight": "600" }],
    "data": ["14px", { "lineHeight": "1.4", "fontWeight": "500" }],
    "button": ["14px", { "lineHeight": "1", "letterSpacing": "0.02em", "fontWeight": "600" }],
    "overline": ["12px", { "lineHeight": "1.2", "letterSpacing": "0.08em", "fontWeight": "700" }]
  },
  "fontWeight": {
    "regular": "400",
    "medium": "500",
    "semibold": "600",
    "bold": "700",
    "extrabold": "800"
  },
  "spacing": {
    "0": "0",
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "20px",
    "6": "24px",
    "8": "32px",
    "10": "40px",
    "12": "48px",
    "16": "64px"
  },
  "borderRadius": {
    "sm": "4px",
    "md": "8px",
    "lg": "12px",
    "xl": "16px",
    "full": "9999px"
  },
  "boxShadow": {
    "light": {
      "shadow-1": "0 1px 2px rgba(0, 0, 0, 0.08)",
      "shadow-2": "0 4px 16px rgba(0, 0, 0, 0.12)"
    },
    "dark": {
      "shadow-1": "none",
      "shadow-2": "none"
    }
  },
  "transitionDuration": {
    "fast": "150ms",
    "base": "200ms"
  },
  "transitionTimingFunction": {
    "default": "ease-out"
  },
  "layout": {
    "sidebar-width": "240px",
    "topbar-height": "56px",
    "table-row-height": "48px",
    "input-height": "40px",
    "button-height-sm": "32px",
    "button-height-md": "40px",
    "button-height-lg": "48px",
    "touch-target-min": "44px"
  },
  "breakpoints": {
    "sm": "375px",
    "md": "768px",
    "lg": "1024px",
    "xl": "1440px"
  },
  "screens": {
    "$comment": "Alias semántico para Tailwind config — mobile-first según design-system.md §6",
    "mobile": "375px",
    "tablet": "768px",
    "desktop": "1024px",
    "wide": "1440px"
  }
}
