# =============================================================================
# BodegApp — environment example (NON-SENSITIVE variables only)
# Copy to .env and adjust. NEVER put passwords, API keys, JWT secrets or any
# sensitive value here: sensitive material is managed as Docker secrets
# (see README.md). This file MUST stay committable and safe to share.
#
# NOTE: this file is force-added in ST-01 (the root .gitignore `.env.*`
# pattern was silently excluding it from the repo while the README and
# compose referenced it — hallazgo ST-01-05).
# =============================================================================

# --- PostgreSQL (non-sensitive connection parameters) ---
# Password is NOT here: it lives in infra/docker/secrets/postgres_password.txt
POSTGRES_USER=bodegapp
POSTGRES_DB=bodegapp

# --- Frontend build (public values; part of the static bundle) ---
# NEVER embed secrets in VITE_* variables: everything Vite builds is public.
VITE_API_BASE_URL=/api

# --- Misc ---
TZ=UTC
