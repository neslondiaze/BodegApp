# =============================================================================
# BodegApp — Frontend image (React 19 + Vite build -> nginx)
# Multi-stage, non-root, minimal attack surface (Sentinel Shield v1.0).
# Build context: frontend/ (dockerfile: ../infra/docker/Dockerfile.frontend).
#
# The nginx.conf serving this build is NOT bind-mounted: it is baked into the
# image via an additional build context (see compose `additional_contexts`)
# so the running container is fully immutable.
# =============================================================================

# -----------------------------------------------------------------------------
# Stage 1: build — compile the Vite SPA.
# -----------------------------------------------------------------------------
FROM node:22-alpine AS build

WORKDIR /app

# Install dependencies first (better layer caching).
# hadolint ignore=DL3016 (lockfile is used when present)
COPY package*.json ./
RUN --mount=type=cache,target=/root/.npm \
    npm ci --ignore-scripts || npm install --ignore-scripts

# Build-time configuration (public, non-sensitive). API base URL becomes
# part of the static bundle — NEVER put secrets in VITE_* variables.
ARG VITE_API_BASE_URL=/api
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}

# Copy the rest of the sources and build.
COPY . .
RUN npm run build

# -----------------------------------------------------------------------------
# Stage 2: runtime — nginx serving the static SPA, non-root.
# -----------------------------------------------------------------------------
FROM nginx:1.27-alpine

# Security metadata
LABEL org.opencontainers.image.title="bodegapp-frontend" \
      org.opencontainers.image.description="BodegApp React 19 + Vite frontend served by nginx" \
      org.opencontainers.image.vendor="Diaz Tech" \
      org.opencontainers.image.version="0.1.0"

# Baked-in hardened nginx config (from additional context "docker"): the
# main config (pid in /tmp for read-only rootfs) + the SPA server block.
RUN rm -f /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist/ /usr/share/nginx/html/
COPY --from=docker frontend/nginx-main.conf /etc/nginx/nginx.conf
COPY --from=docker frontend/nginx.conf /etc/nginx/conf.d/default.conf

CMD ["nginx", "-g", "daemon off;"]

# Non-root user matching the container runtime user in docker-compose.yml.
USER 101:101

EXPOSE 8080

STOPSIGNAL SIGTERM
