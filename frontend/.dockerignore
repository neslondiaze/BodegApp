# =============================================================================
# BodegApp — frontend build context exclusions (BT-01, ST-01)
# Keeps `COPY . .` in Dockerfile.frontend from shipping local artifacts
# (node_modules, build output, editor/OS noise) into the image build context.
# =============================================================================

# Dependencies — rebuilt inside the image from package-lock.json
node_modules/

# Previous build output — regenerated by `npm run build`
dist/
build/

# Local tooling caches
.vite/
coverage/
*.log
logs/

# Environment files — never part of the image (VITE_* values are public but
# .env files must not leak into build context)
.env
.env.*

# Editor / IDE
.idea/
.vscode/
*.swp
.obsidian/
.atl/

# OS noise
.DS_Store
Thumbs.db

# Code intelligence indexes and test caches
.codegraph/
.pytest_cache/
